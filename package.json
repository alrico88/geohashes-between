{
  "version": "2.3.0",
  "name": "geohashes-between",
  "author": "Alberto Rico",
  "keywords": [
    "geohashes",
    "between",
    "direction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrico88/geohashes-between.git"
  },
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint:package": "bun run build && publint --strict && attw --pack",
    "check": "bun run lint:package && bun run lint && bun run typecheck && bun run coverage",
    "prepack": "bun run lint && bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@rslib/core": "^1.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/ngeohash": "^0.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "publint": "0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "grid-cross": "1.0.0",
    "ngeohash": "^0.6.3",
    "valibot": "^1.5.0"
  }
}
